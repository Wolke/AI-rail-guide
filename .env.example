# Required only for the local Realtime mode. Never expose this value to Vite.
OPENAI_API_KEY=

# Optional local Realtime overrides.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
RAILTALK_SERVER_PORT=8787

# Optional inputs for `npm run data:update`. Each URL must return JSON.
RAIL_STATIONS_URL=
RAIL_TOURISM_URL=

{
  "name": "ai-rail-voice-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "start": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.json",
    "web:dev": "vite --config vite.config.ts",
    "web:build": "tsc -p tsconfig.web.json && vite build --config vite.config.ts",
    "web:test": "vitest run --config vitest.web.config.ts",
    "web:secrets": "node scripts/check_web_secrets.mjs",
    "data:update": "node scripts/update_rail_data.mjs",
    "realtime:server": "tsx src/server/index.ts",
    "realtime:dev": "concurrently --kill-others-on-fail --names server,web \"npm:realtime:server\" \"npm:web:dev\"",
    "test": "vitest run",
    "audio:build": "mkdir -p .build/swift-cache && swiftc -module-cache-path .build/swift-cache src/audio/AudioHelper.swift -o .build/rail-audio-helper -framework AVFoundation",
    "smoke:live": "AI_RAIL_LIVE_TEST=1 vitest run src/cli/live.test.ts"
  },
  "dependencies": {
    "concurrently": "^10.0.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.20.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.1.4",
    "jsdom": "^26.1.0",
    "supertest": "^7.2.2",
    "typescript": "^5.8.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.0"
  }
}
